# Copy to .env and adjust. Every setting is optional.

# production | development | test. Production turns on Secure cookies.
FALCON_ENVIRONMENT=development

# Where the API and console listen.
FALCON_HOST=127.0.0.1
FALCON_PORT=8600

# Storage. Defaults to SQLite in ./data. For PostgreSQL:
# FALCON_DATABASE_URL=postgresql+psycopg://falcon:secret@db.internal:5432/falcon
# FALCON_DATA_DIR=/var/lib/falcon

# Sessions: sliding idle timeout (minutes) and absolute lifetime (hours).
FALCON_SESSION_IDLE_MINUTES=120
FALCON_SESSION_ABSOLUTE_HOURS=12

# Force Secure cookies on or off (defaults to on in production). Set true behind TLS.
# FALCON_SECURE_COOKIES=true

# Brute-force protection.
FALCON_LOGIN_MAX_FAILURES=5
FALCON_LOGIN_LOCKOUT_MINUTES=15
FALCON_LOGIN_RATE_PER_MINUTE=20

# How long invitation and access-reset links stay valid (hours).
FALCON_INVITATION_VALID_HOURS=72
